# backend/.env.example
DB_URL=jdbc:postgresql://localhost:5432/school_db
DB_USER=postgres
DB_PASS=postgres
APP_PORT=8080
APP_URL=http://localhost:8080
APP_CORS_ORIGIN=http://localhost:5173
PASS_MARK=40
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PHONE=08000000000
SEED_ADMIN_EMAIL=admin@school.com
SEED_ADMIN_PASSWORD=supersecret
SMS_MODE=mock
EMAIL_MODE=mock
SMS_API_URL=https://api.smsprovider.com/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=SCHOOL
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=noreply@school.com